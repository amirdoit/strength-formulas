{
  "name": "strength-formulas",
  "version": "0.1.0",
  "description": "Zero-dependency, cross-checked strength-sport math: Wilks, Wilks-2020, DOTS, IPF Points, IPF GL, one-rep-max estimators and plate loading.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "keywords": [
    "powerlifting",
    "wilks",
    "dots",
    "ipf-gl",
    "goodlift",
    "one-rep-max",
    "1rm",
    "e1rm",
    "plate-calculator",
    "strength",
    "weightlifting",
    "mcp"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirdoit/strength-formulas.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/amirdoit/strength-formulas#readme",
  "bugs": {
    "url": "https://github.com/amirdoit/strength-formulas/issues"
  },
  "author": "Amir Iqbal"
}
